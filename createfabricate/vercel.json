{
  "version": 2,
  "functions": {
    "api/contact.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
